# Base URL of the ServicePro FSMS API (include /api/v1). Deployed example: https://your-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Public URL of THIS frontend (used for Open Graph / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Stripe publishable key (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional: WebSocket origin for live notifications (defaults to the API origin). Only works when the API runs on a long-lived host such as Render.
NEXT_PUBLIC_WS_URL=
